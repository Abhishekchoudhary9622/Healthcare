# ──────────────────────────────────────────────
# HealthSync Backend – Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── App ───────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/healthsync

# ── JWT ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis (optional – used for Bull queues) ───
# Leave blank to use in-memory fallback
REDIS_URL=redis://localhost:6379

# ── Email (Nodemailer) ────────────────────────
# Gmail example: enable "App Passwords" in your Google Account
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM_NAME=HealthSync
EMAIL_FROM_ADDRESS=noreply@healthsync.com

# ── OpenAI (LLM) ─────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Leave blank to use mock/fallback summaries (system won't break)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# ── Google Calendar OAuth2 ────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable Google Calendar API
# 3. Create OAuth2 credentials (Web Application)
# 4. Add redirect URI: http://localhost:5000/api/calendar/callback
# Leave blank to disable Calendar integration (system won't break)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# ── Slot Hold ─────────────────────────────────
# Minutes a slot is held while patient fills in symptoms
SLOT_HOLD_TTL_MINUTES=10

{
  "name": "healthcare-backend",
  "version": "1.0.0",
  "description": "Healthcare Appointment & Follow-up Manager Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon",
    "build:ui": "cd ../frontend && npm run build",
    "setup": "npm install && cd ../frontend && npm install",
    "seed": "node prisma/seed.js",
    "go": "npm run build:ui && npm start",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.12.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "5.10.2",
    "bcryptjs": "2.4.3",
    "bull": "4.12.2",
    "compression": "1.7.4",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.3",
    "express-rate-limit": "7.2.0",
    "express-validator": "7.0.1",
    "googleapis": "140.0.1",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "^9.9.3",
    "morgan": "1.10.0",
    "node-cron": "3.0.3",
    "nodemailer": "6.9.12",
    "openai": "4.29.2",
    "redis": "4.6.13",
    "socket.io": "^4.8.3",
    "uuid": "9.0.1",
    "winston": "3.12.0"
  },
  "devDependencies": {
    "nodemon": "3.1.0",
    "prisma": "5.10.2"
  }
}
